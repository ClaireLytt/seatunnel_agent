# ============================================================
# LLM Provider Configuration
# ============================================================
# Tip: the web UI's Settings page (/settings) can configure all LLM_* values
# from the browser — saved values override this file for the web UI.

# Provider: "anthropic" (default) or "openai" (covers DeepSeek, Qwen, GLM, Moonshot, etc.)
LLM_PROVIDER=anthropic

# API Key (required) — also accepts ANTHROPIC_API_KEY for backward compatibility
# - Anthropic: sk-ant-...
# - OpenAI:    sk-...
# - DeepSeek:  sk-...
API_KEY=your-api-key-here

# Model name
# - Anthropic: claude-opus-5, claude-sonnet-5, claude-haiku-4-5
# - OpenAI:    gpt-4o, gpt-4o-mini
# - DeepSeek:  deepseek-chat, deepseek-reasoner
# - Qwen:      qwen-plus, qwen-turbo
MODEL_NAME=claude-opus-5

# Base URL (only needed for non-default endpoints)
# - DeepSeek:  https://api.deepseek.com
# - Qwen:      https://dashscope.aliyuncs.com/compatible-mode/v1
# - GLM:       https://open.bigmodel.cn/api/paas/v4
# - Moonshot:  https://api.moonshot.cn/v1
# - Leave empty for Anthropic or OpenAI (uses default endpoint)
LLM_BASE_URL=

# ============================================================
# SeaTunnel Configuration
# ============================================================

# Optional: Path to your Apache SeaTunnel installation
# Config generation, validation, and diagnosis work without it.
# Only needed for actually running SeaTunnel jobs (run/batch commands).
# Example (Linux/Mac): /opt/apache-seatunnel-2.3.8
# Example (Windows): C:\apache-seatunnel-2.3.8
# SEATUNNEL_HOME=/path/to/apache-seatunnel

# ============================================================
# Agent Behavior
# ============================================================

# Maximum retry attempts for failed jobs (default: 3)
# MAX_RETRIES=3

# Maximum tokens per LLM call (default: 16000)
# MAX_TOKENS=16000

# Job execution timeout in seconds (default: 120)
# JOB_TIMEOUT=120

# LLM API request timeout in seconds (default: 120)
# Increase if you see timeout errors with slow endpoints
# LLM_TIMEOUT=120

# LLM temperature — 0.0 for deterministic output (default: 0.0)
# TEMPERATURE=0.0

# Directory for generated config files (default: configs)
# CONFIG_DIR=configs

# ============================================================
# Text2SQL (Chat BI) Configuration
# ============================================================

# Schema whitelist DDL file — only tables listed here can be queried
# SCHEMA_DDL_PATH=config/schema_ddl.sql

# ── Hive ──
# HIVE_HOST=10.0.0.1
# HIVE_PORT=10000
# HIVE_DATABASE=default
# HIVE_USERNAME=
# HIVE_TIMEOUT=300

# ── Spark SQL (Thrift Server) ──
# Falls back to HIVE_* vars when SPARK_* are absent
# SPARK_HOST=10.0.0.1
# SPARK_PORT=10001
# SPARK_DATABASE=default
# SPARK_USERNAME=

# ── MySQL ──
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_DATABASE=mydb
# MYSQL_USERNAME=root
# MYSQL_PASSWORD=

# ── SQL Server ──
# MSSQL_HOST=127.0.0.1
# MSSQL_PORT=1433
# MSSQL_DATABASE=master
# MSSQL_USERNAME=sa
# MSSQL_PASSWORD=

# ── ClickHouse ──
# CLICKHOUSE_HOST=127.0.0.1
# CLICKHOUSE_PORT=8123
# CLICKHOUSE_DATABASE=default
# CLICKHOUSE_USERNAME=default
# CLICKHOUSE_PASSWORD=

# ── Doris / StarRocks (MySQL protocol) ──
# DORIS_HOST=127.0.0.1
# DORIS_PORT=9030
# DORIS_DATABASE=mydb
# DORIS_USERNAME=root
# DORIS_PASSWORD=

# ── PostgreSQL ──
# PG_HOST=127.0.0.1
# PG_PORT=5432
# PG_DATABASE=postgres
# PG_USERNAME=postgres
# PG_PASSWORD=

# -- Text2SQL hybrid retrieval (optional) --
# Vector channel for table retrieval: set EMBEDDING_MODEL to enable.
# Endpoint must be OpenAI-compatible (/embeddings). Unset = keyword+BM25 only.
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=
# Fusion weights keyword,bm25,vector (renormalized when vector is off):
# T2S_RETRIEVAL_WEIGHTS=0.4,0.3,0.3
# Above this table count, the system prompt injects names only (context-rot guard):
# T2S_SCHEMA_PROMPT_LIMIT=50
# Metric provenance: SQL directory for the lineage upstream chain in trace_metric:
# T2S_LINEAGE_SQL_DIR=warehouse_sql/
# Slow-query threshold (ms) above which execute_sql attaches data-skew hints:
# T2S_SLOW_QUERY_MS=5000
# REST API auth (optional): when set, every /api route requires X-API-Key header:
# SEATUNNEL_API_KEY=
# Feishu app credentials (optional): enable chart image embedding in subscription cards:
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
